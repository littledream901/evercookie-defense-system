# ============================================================
# Evercookie Defense System V2 - 环境变量模板
# 使用: cp .env.example .env 后按实际情况修改
# ============================================================

# ---------- 基础 ----------
ENV=development
SERVICE_NAME=fangyu-v2
LOG_LEVEL=INFO
LOG_JSON=true

# ---------- Gateway API ----------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=4
GATEWAY_DECISION_CACHE_TTL=120

# ---------- Admin API ----------
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8001
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-please
ADMIN_JWT_ACCESS_TTL=1800
ADMIN_JWT_REFRESH_TTL=604800

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=2

# ---------- MySQL ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=fangyu
MYSQL_PASSWORD=fangyu_pass
MYSQL_DATABASE=fangyu_v2
MYSQL_URL=mysql+asyncmy://fangyu:fangyu_pass@mysql:3306/fangyu_v2

# ---------- ClickHouse ----------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=fangyu_v2

# ---------- Stream / Worker ----------
STREAM_KEY=fangyu:events:v2
STREAM_CONSUMER_GROUP=worker-group-v2
STREAM_CONSUMER_NAME=worker-1
WORKER_BATCH_SIZE=500
WORKER_BATCH_TIMEOUT_MS=1000

# ---------- MMDB ----------
MMDB_COUNTRY_PATH=/data/mmdb/GeoLite2-Country.mmdb
MMDB_ASN_PATH=/data/mmdb/GeoLite2-ASN.mmdb

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

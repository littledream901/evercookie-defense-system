# ============================================================
# Evercookie Defense System V2 — 本地开发环境变量模板
# 使用：cp .env.example .env 后按实际情况修改
#
# 各服务用 pydantic-settings 按前缀读取，前缀由代码里的
# env_prefix 决定，写错前缀等于没配：
#   GATEWAY_*  → gateway-api  （gateway-api/src/config.py）
#   ADMIN_*    → admin-api    （admin-api/src/config.py）
#   WORKER_*   → worker       （worker/src/config.py）
#   VITE_*     → dashboard-ui （构建期注入，见 dashboard-ui/.env.*）
#
# 少数变量是**无前缀**的，由代码直接 os.getenv 读取，不要加前缀：
#   CLICKHOUSE_URL / CLICKHOUSE_DATABASE / CLICKHOUSE_USER / CLICKHOUSE_PASSWORD
#     → shared/src/fangyu_shared/clickhouse_manager/config.py
#   MMDB_DIR          → admin-api/src/interfaces/http/v1/mmdb.py
#   ABUSEIPDB_API_KEY → admin-api/src/infrastructure/external_intel_fetcher.py
#
# 生产部署请用 .env.production.example，不要用本文件。
# ============================================================


# ============================================================
# 第一部分：必须修改
# ============================================================

# ── admin-api 数据库（无默认值，缺失则启动失败） ──────────────
ADMIN_DATABASE_URL=mysql+asyncmy://fangyu:fangyu_pass@localhost:3306/fangyu_v2

# ── JWT 密钥（无默认值，长度下限 32，缺失或过短则启动失败） ────
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# ── ClickHouse（无前缀，被 shared 的 ClickHouseConfig 读取） ──
# 库名必须是 fangyu：analytics_query.py 与 reputation_sync_service.py
# 中的表前缀是硬编码的，改库名会导致查不到表。
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=fangyu
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────
# 必须写 JSON 数组：代码里是 pydantic 的 list[str]，
# 逗号分隔字符串会解析失败导致服务启动即崩溃。
#
# gateway 保持 ["*"]：SDK 从各接入方站点发起请求，来源无法枚举。
# 对应的 cors_allow_credentials 默认为 False，两者不可同时放开。
GATEWAY_CORS_ORIGINS=["*"]
# admin 默认空列表，本地开发放行前端 dev server。
ADMIN_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── 外部情报源（无前缀，不填则跳过该来源） ───────────────────
ABUSEIPDB_API_KEY=


# ============================================================
# 第二部分：可按需调整（值即代码默认值）
# ============================================================

# ── docker-compose.yml 的插值变量 ─────────────────────────────
# 这三项不被服务代码读取，只用于本地 compose 文件的 ${VAR:-default}
# 插值。compose 会把它们以无前缀形式注入容器，而各服务的 Settings
# 都带前缀，因此改这里不影响服务行为 —— 要调日志级别请改下面
# 第三部分的 GATEWAY_LOG_LEVEL / ADMIN_LOG_LEVEL / WORKER_LOG_LEVEL。
ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# ── 风险阈值（累加截顶模型，对齐原版 30/75 口径） ─────────────
GATEWAY_CHALLENGE_THRESHOLD=30.0
GATEWAY_BLOCK_THRESHOLD=75.0

# ── 安全开关 ──────────────────────────────────────────────────
GATEWAY_BLOCK_TOR=true
# IP / 国家黑名单，JSON 数组（代码里是 list[str]）
GATEWAY_IP_BLACKLIST=[]
GATEWAY_COUNTRY_BLOCKLIST=[]

# 请求签名。代码默认 true，三个服务端适配器与浏览器 SDK 均已实现签名，
# 开启不会拦掉自家流量。仅在存在未改造的第三方接入方时才临时关闭 ——
# 关闭期间任何人都能伪造 fingerprint / ip / behavior 上报，风控输入不可信。
GATEWAY_SIGNATURE_REQUIRED=true

# 流水线级开关，关闭可省掉对应的 Redis 开销
GATEWAY_CLOCK_ENABLED=true
GATEWAY_WHITELIST_ENABLED=true

# ── 声誉回流 ──────────────────────────────────────────────────
WORKER_REPUTATION_ENABLED=true
WORKER_REPUTATION_SYNC_INTERVAL_SECONDS=3600
WORKER_REPUTATION_LOOKBACK_DAYS=7
WORKER_REPUTATION_MIN_SAMPLES=5


# ============================================================
# 第三部分：默认配置（通常无需修改）
# ============================================================

# ── Redis ────────────────────────────────────────────────────
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_REDIS_MAX_CONNECTIONS=100
ADMIN_REDIS_URL=redis://localhost:6379/0
ADMIN_REDIS_MAX_CONNECTIONS=50
WORKER_REDIS_URL=redis://localhost:6379/0
WORKER_REDIS_MAX_CONNECTIONS=50

# ── 各服务的 ClickHouse 覆盖项 ────────────────────────────────
# 三个服务各自也有带前缀的 ClickHouse 配置字段，留空则用上面的
# 无前缀值。库名同样必须是 fangyu。
GATEWAY_CLICKHOUSE_URL=http://localhost:8123
GATEWAY_CLICKHOUSE_DATABASE=fangyu
ADMIN_CLICKHOUSE_URL=http://localhost:8123
ADMIN_CLICKHOUSE_DATABASE=fangyu
ADMIN_CLICKHOUSE_USER=default
ADMIN_CLICKHOUSE_PASSWORD=
WORKER_CLICKHOUSE_URL=http://localhost:8123
WORKER_CLICKHOUSE_DATABASE=fangyu
WORKER_CLICKHOUSE_USER=default
WORKER_CLICKHOUSE_PASSWORD=

# ── 服务监听 ──────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_WORKERS=4
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8081
ADMIN_WORKERS=2
WORKER_HEALTH_PORT=9091
WORKER_METRICS_PORT=9092
WORKER_CONCURRENCY=2

# ── 日志 ──────────────────────────────────────────────────────
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_FORMAT=json
ADMIN_LOG_LEVEL=INFO
ADMIN_LOG_FORMAT=json
WORKER_LOG_LEVEL=INFO
WORKER_LOG_FORMAT=json

# ── JWT ───────────────────────────────────────────────────────
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_TTL_SECONDS=7200
ADMIN_JWT_REFRESH_TTL_SECONDS=604800

# ── admin 数据库连接池与限流 ──────────────────────────────────
ADMIN_DATABASE_POOL_SIZE=10
ADMIN_DATABASE_MAX_OVERFLOW=20
ADMIN_DATABASE_POOL_RECYCLE=3600
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10
ADMIN_PERMISSION_CACHE_TTL=300

# ── MMDB ──────────────────────────────────────────────────────
# MMDB_DIR 无前缀，由 admin-api 上传端点直接 os.getenv 读取；
# gateway 侧用带前缀的两个具体路径。三者需指向同一挂载卷。
MMDB_DIR=/data/mmdb
GATEWAY_MMDB_COUNTRY_PATH=/data/mmdb/GeoLite2-Country.mmdb
GATEWAY_MMDB_ASN_PATH=/data/mmdb/GeoLite2-ASN.mmdb

# ── Redis Stream（gateway 写入，worker 消费，两侧名字必须一致） ─
GATEWAY_EVENT_STREAM_NAME=fangyu:events:decision
GATEWAY_EVENT_STREAM_MAXLEN=500000
WORKER_STREAM_NAME=fangyu:events:decision
WORKER_CONSUMER_GROUP=fangyu-worker
# 消费者名默认按 hostname-pid 生成，保证多副本不重名。
# 显式设置会覆盖默认值，多副本部署时务必保证各副本取值不同，
# 否则副本间会互相读到彼此的 pending 消息并重复写入 ClickHouse。
# WORKER_CONSUMER_NAME=worker-1
WORKER_STREAM_BATCH_SIZE=200
# 必须显著小于 Redis 客户端 socket_timeout（默认 5s）。
# 两者相等时 XREADGROUP 阻塞满时长返回的瞬间读超时同时到期，
# 会抛 TimeoutError 让消费循环崩溃。
WORKER_STREAM_BLOCK_MS=2000
WORKER_STREAM_CLAIM_MIN_IDLE_MS=60000

# ── Worker 批量写入与重试 ─────────────────────────────────────
WORKER_BATCH_SIZE=500
WORKER_BATCH_FLUSH_INTERVAL_SECONDS=5.0
# 库名是 fangyu 而非 fangyu_v2 —— 后者是 MySQL 的库名，两者不同。
WORKER_BATCH_TARGET_TABLE=fangyu.decision_events
WORKER_MAX_RETRIES=3
WORKER_MAX_DELIVERY_COUNT=5
WORKER_DEAD_LETTER_STREAM=fangyu:events:decision:dlq

# ── App Key 校验 ──────────────────────────────────────────────
GATEWAY_APP_KEY_REQUIRED=true
GATEWAY_APP_KEY_HEADER=X-App-Key
GATEWAY_SIGNATURE_WINDOW=300

# ── 缓存 TTL ──────────────────────────────────────────────────
GATEWAY_DECISION_CACHE_TTL=60
GATEWAY_PROFILE_CACHE_TTL=3600

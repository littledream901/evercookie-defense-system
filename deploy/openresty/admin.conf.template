# =============================================================================
# 1Panel OpenResty 站点配置 — 管理后台（dashboard-ui）
# -----------------------------------------------------------------------------
# 本文件已填入真实值，可整份复制进 1Panel 站点配置，无需再替换占位符。
#   域名      defense.foxfingerlab.com   ← 若你的后台域名不是这个，全文替换掉
#   上游端口  8080（docker-compose 的 UI_PUBLISH_PORT）
#
# 之前 gateway 那份保存报错的原因同样适用于此：配置里不能残留 {{...}}，
# 占位符的花括号会被 nginx 当成块起始符，报
#     directive "xxx" is not terminated by ";"
#
# 说明：
#   - 静态资源缓存、gzip、SPA 回退、/api 反代已在容器内 Nginx 处理，
#     这里只做 TLS 终结 + 转发 + 边缘限流，避免两层重复配置互相干扰。
# =============================================================================

limit_req_zone $binary_remote_addr zone=admin_req:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=admin_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name defense.foxfingerlab.com;

    # ACME 质询放行，其余强制跳转 HTTPS
    location ^~ /.well-known/acme-challenge/ {
        root /www/server/openresty/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name defense.foxfingerlab.com;

    # ── TLS ──────────────────────────────────────────────────────
    # 路径按 1Panel 容器内挂载点。若 nginx -t 报证书找不到，先执行
    #   docker exec 1Panel-openresty ls /www/sites/defense.foxfingerlab.com/ssl/
    # 确认实际文件名后改这两行。
    ssl_certificate     /www/sites/defense.foxfingerlab.com/ssl/fullchain.pem;
    ssl_certificate_key /www/sites/defense.foxfingerlab.com/ssl/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL_ADMIN:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 64m;   # MMDB 文件上传需要较大 body

    # ── 安全响应头 ────────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options          "SAMEORIGIN" always;
    add_header X-Content-Type-Options   "nosniff" always;
    add_header Referrer-Policy          "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy       "geolocation=(), microphone=(), camera=()" always;

    # ── 边缘限流 ──────────────────────────────────────────────────
    limit_req  zone=admin_req burst=100 nodelay;
    limit_conn admin_conn 50;

    access_log /var/log/nginx/defense.foxfingerlab.com.access.log;
    error_log  /var/log/nginx/defense.foxfingerlab.com.error.log warn;

    # 登录接口额外收紧，防口令爆破（admin-api 侧还有一层应用级限流）
    location = /api/v2/auth/login {
        limit_req zone=admin_login burst=5 nodelay;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        # ⚠️ 安全：原模板在此用 allow <办公网段> + deny all 把后台收口到内网。
        # 我不知道你的固定出口 IP，若填错会把你自己锁在门外，所以暂时放开。
        # 后台是全系统的控制面，长期对公网敞开风险很高。
        # 拿到固定 IP 后取消下面三行注释并填上，或改用 VPN / 堡垒机接入。
        #
        # allow 203.0.113.0/24;   ← 换成你的实际网段
        # allow 127.0.0.1;
        # deny  all;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # 上游已 gzip，此处不重复压缩
        gzip off;
    }

    # 健康检查供外部探活，不做 IP 限制
    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:8080/healthz;
    }
}

# =============================================================================
# 1Panel OpenResty 站点配置 — 决策网关（gateway-api）
# -----------------------------------------------------------------------------
# 本文件已填入真实值，可整份复制进 1Panel 站点配置，无需再替换占位符。
#   域名      gateway.foxfingerlab.com
#   上游端口  8000（docker-compose 的 GATEWAY_PUBLISH_PORT）
#
# 之前保存报错的原因：
#   旧版这里写的是 server 127.0.0.1:{{GATEWAY_PORT}}，占位符里的花括号被
#   nginx 当成块起始符，于是报
#       directive "server" is not terminated by ";"
#   nginx 配置中任何位置都不能残留 {{...}}。
#
# 注意：
#   - 决策接口是跨站调用，CORS 由 gateway-api 应用层按 GATEWAY_CORS_ORIGINS
#     白名单处理。此处不要再加 Access-Control-Allow-Origin，重复头会被浏览器拒绝。
#   - 不要对该域名启用防盗链（Referer 校验）：SDK 就是从第三方站点发起请求的，
#     校验 Referer 会把正常流量全部拦掉。
# =============================================================================

upstream fangyu_gateway {
    server 127.0.0.1:8000 max_fails=3 fail_timeout=15s;
    keepalive 64;
}

# 决策接口按 IP 限流；SDK 正常节奏远低于此，主要拦刷量
limit_req_zone $binary_remote_addr zone=gw_decide:20m rate=100r/s;
limit_req_zone $binary_remote_addr zone=gw_general:20m rate=200r/s;
limit_conn_zone $binary_remote_addr zone=gw_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name gateway.foxfingerlab.com;

    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 100.64.0.0/10;
    set_real_ip_from 169.254.0.0/16;
    set_real_ip_from ::1;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    location ^~ /.well-known/acme-challenge/ {
        root /www/server/openresty/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gateway.foxfingerlab.com;

    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 100.64.0.0/10;
    set_real_ip_from 169.254.0.0/16;
    set_real_ip_from ::1;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    # ── TLS ──────────────────────────────────────────────────────
    # 路径按 1Panel 容器内挂载点。若 nginx -t 报证书找不到，先执行
    #   docker exec 1Panel-openresty ls /www/sites/gateway.foxfingerlab.com/ssl/
    # 确认实际文件名后改这两行。更稳的做法是在 1Panel 站点里点「HTTPS」
    # 申请证书，由面板自动写入路径，然后只保留下面的 location 段。
    ssl_certificate     /www/sites/gateway.foxfingerlab.com/ssl/fullchain.pem;
    ssl_certificate_key /www/sites/gateway.foxfingerlab.com/ssl/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL_GW:20m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    # 决策请求体是画像 JSON，正常几 KB；限死上限防打大包
    client_max_body_size 128k;
    client_body_buffer_size 128k;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "no-referrer" always;

    limit_conn gw_conn 200;

    access_log /var/log/nginx/gateway.foxfingerlab.com.access.log;
    error_log  /var/log/nginx/gateway.foxfingerlab.com.error.log warn;

    # ── 决策主链路 ────────────────────────────────────────────────
    # 超时压得很短：决策是同步阻塞在业务页面加载路径上的，
    # 网关慢于 5s 不如快速失败让 SDK 走本地降级。
    location /v2/decide {
        limit_req zone=gw_decide burst=200 nodelay;

        proxy_pass http://fangyu_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Connection        "";

        proxy_connect_timeout 2s;
        proxy_send_timeout    3s;
        proxy_read_timeout    5s;
        proxy_next_upstream   error timeout http_502 http_503;
    }

    location /v2/ {
        limit_req zone=gw_general burst=400 nodelay;

        proxy_pass http://fangyu_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Connection        "";

        proxy_connect_timeout 3s;
        proxy_send_timeout    10s;
        proxy_read_timeout    15s;
    }

    # ── 探活与指标 ────────────────────────────────────────────────
    location = /healthz {
        access_log off;
        proxy_pass http://fangyu_gateway/v2/healthz;
    }

    location = /readyz {
        access_log off;
        proxy_pass http://fangyu_gateway/v2/readyz;
    }

    # 指标含内部拓扑信息，仅内网可抓
    location = /metrics {
        allow 172.16.0.0/12;
        allow 127.0.0.1;
        deny  all;
        access_log off;
        proxy_pass http://fangyu_gateway/v2/metrics;
    }

    # ── SDK 静态分发 ──────────────────────────────────────────────
    # client-sdk 的构建产物随 gateway 镜像发布，由应用层 StaticFiles 挂在
    # /sdk 上（见 gateway-api/src/main.py 的 _mount_sdk_static）。
    #
    # 这里不做鉴权也不限流到决策那么严：SDK 文件要公开发给任意接入站点的
    # 浏览器，要求先持 API Key 才能下载脚本逻辑上不成立。
    #
    # 这里不要加 Access-Control-Allow-Origin：
    # 应用层的 CORSMiddleware 是 ASGI 中间件，包裹整个 app，/sdk 的 StaticFiles
    # 挂载点同样在其覆盖范围内（见 main.py 的 create_app：先 add_middleware
    # 再 mount）。nginx 再加一次会让响应出现两个同名头，浏览器直接报
    #   'Access-Control-Allow-Origin' header contains multiple values '*, *'
    # 并拒收整个响应。
    # 该问题在 GATEWAY_CORS_ORIGINS 是具体白名单时不暴露：应用层对不在白名单的
    # 源不回该头，只剩 nginx 这一份。一旦白名单改成 ["*"]，两份同时出现，
    # /sdk/ 立刻全站加载失败。
    location ^~ /sdk/ {
        limit_req zone=gw_general burst=400 nodelay;

        proxy_pass http://fangyu_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection        "";

        proxy_connect_timeout 3s;
        proxy_read_timeout    10s;

        # 静态产物按内容寻址程度不高（文件名不带 hash），缓存 1h 折中：
        # 既减轻回源，又让 SDK 升级能在一小时内自然收敛。
        proxy_cache_valid 200 1h;
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # 未匹配路径直接拒绝，不给探测面
    location / {
        return 404;
    }
}

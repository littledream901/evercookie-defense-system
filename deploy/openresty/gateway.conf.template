# =============================================================================
# 1Panel OpenResty 站点配置 — 决策网关（gateway-api）
# -----------------------------------------------------------------------------
# 这是 SDK 上报入口，面向公网高并发，与管理后台分域名部署。
#
# 占位符：
#   {{GATEWAY_DOMAIN}}   网关域名，需与前端 VITE_GATEWAY_URL 一致
#   {{GATEWAY_PORT}}     docker-compose 中 GATEWAY_PUBLISH_PORT（默认 8000）
#   {{INTERNAL_CIDR}}    允许抓取 /metrics 的内网网段
#
# 注意：
#   - 决策接口是跨站调用，CORS 由 gateway-api 应用层按
#     GATEWAY_CORS_ORIGINS 白名单处理。此处不要再加 add_header
#     Access-Control-Allow-Origin，否则会出现重复头导致浏览器拒绝。
#   - 不要对该域名启用防盗链（Referer 校验）：SDK 就是从第三方站点
#     发起请求的，校验 Referer 会把正常流量全部拦掉。
# =============================================================================

upstream fangyu_gateway {
    server 127.0.0.1:{{GATEWAY_PORT}} max_fails=3 fail_timeout=15s;
    keepalive 64;
}

# 决策接口按 IP 限流；SDK 正常节奏远低于此，主要拦刷量
limit_req_zone $binary_remote_addr zone=gw_decide:20m rate=100r/s;
limit_req_zone $binary_remote_addr zone=gw_general:20m rate=200r/s;
limit_conn_zone $binary_remote_addr zone=gw_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name {{GATEWAY_DOMAIN}};

    location ^~ /.well-known/acme-challenge/ {
        root /www/server/openresty/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{GATEWAY_DOMAIN}};

    # ── TLS ──────────────────────────────────────────────────────
    ssl_certificate     /opt/1panel/apps/openresty/openresty/www/sites/{{GATEWAY_DOMAIN}}/ssl/fullchain.pem;
    ssl_certificate_key /opt/1panel/apps/openresty/openresty/www/sites/{{GATEWAY_DOMAIN}}/ssl/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL_GW:20m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    # 决策请求体是画像 JSON，正常几 KB；限死上限防打大包
    client_max_body_size 128k;
    client_body_buffer_size 128k;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "no-referrer" always;

    limit_conn gw_conn 200;

    access_log /var/log/nginx/{{GATEWAY_DOMAIN}}.access.log;
    error_log  /var/log/nginx/{{GATEWAY_DOMAIN}}.error.log warn;

    # ── 决策主链路 ────────────────────────────────────────────────
    # 超时压得很短：决策是同步阻塞在业务页面加载路径上的，
    # 网关慢于 5s 不如快速失败让 SDK 走本地降级。
    location /v2/decide {
        limit_req zone=gw_decide burst=200 nodelay;

        proxy_pass http://fangyu_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Connection        "";

        proxy_connect_timeout 2s;
        proxy_send_timeout    3s;
        proxy_read_timeout    5s;
        proxy_next_upstream   error timeout http_502 http_503;
    }

    location /v2/ {
        limit_req zone=gw_general burst=400 nodelay;

        proxy_pass http://fangyu_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id      $request_id;
        proxy_set_header Connection        "";

        proxy_connect_timeout 3s;
        proxy_send_timeout    10s;
        proxy_read_timeout    15s;
    }

    # ── 探活与指标 ────────────────────────────────────────────────
    location = /healthz {
        access_log off;
        proxy_pass http://fangyu_gateway/v2/healthz;
    }

    location = /readyz {
        access_log off;
        proxy_pass http://fangyu_gateway/v2/readyz;
    }

    # 指标含内部拓扑信息，仅内网可抓
    location = /metrics {
        allow {{INTERNAL_CIDR}};
        allow 127.0.0.1;
        deny  all;
        access_log off;
        proxy_pass http://fangyu_gateway/v2/metrics;
    }

    # 未匹配路径直接拒绝，不给探测面
    location / {
        return 404;
    }
}

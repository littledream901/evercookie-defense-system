{
  "name": "@fangyu/sd-sdk",
  "version": "2.0.0",
  "description": "Evercookie Defense System V2 - 客户端 SDK（多通道持久化 + 指纹采集 + V2 三层处置）",
  "type": "module",
  "main": "dist/sd-sdk.min.js",
  "module": "dist/sd-sdk.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sd-sdk.mjs",
      "require": "./dist/sd-sdk.min.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "evercookie",
    "fingerprint",
    "security",
    "anti-fraud",
    "browser-fingerprint"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.10.2",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}

# ============================================================
# Evercookie Defense System V2 — 生产环境变量模板
# ------------------------------------------------------------
# 用法：
#   cp .env.production.example .env.production
#   bash deploy/scripts/gen-secrets.sh        # 生成随机密钥填入
#   chmod 600 .env.production
#
# 重要约定：
#   1. *_CORS_ORIGINS 是 pydantic 的 list[str]，必须写 JSON 数组，
#      逗号分隔字符串会解析失败导致服务启动崩溃。
#   2. Redis/MySQL URL 中的密码若含 @ : / 等字符必须做 URL 编码
#      （@ → %40，: → %3A）。
#   3. ClickHouse 库名固定 fangyu，不可改：analytics_query.py 与
#      reputation_sync_service.py 里的表前缀是硬编码的。
#   4. 本文件含明文口令，权限必须 600，且不得提交到 Git。
# ============================================================


# ============================================================
# 一、镜像与部署标识
# ============================================================

# 镜像仓库前缀与 tag。回滚依赖 tag，禁止长期使用 latest。
IMAGE_REGISTRY=fangyu
IMAGE_TAG=v2.0.0

TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 容器对宿主机发布的回环端口，供 1Panel OpenResty 反代
UI_PUBLISH_PORT=8080
GATEWAY_PUBLISH_PORT=8000

# Docker 网段：与服务器既有网段冲突时改这里
DOCKER_SUBNET=172.28.0.0/16


# ============================================================
# 二、凭据（必须全部替换，勿保留占位值）
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=__REPLACE_MYSQL_ROOT_PASSWORD__
MYSQL_DATABASE=fangyu_v2
MYSQL_USER=fangyu
MYSQL_PASSWORD=__REPLACE_MYSQL_PASSWORD__
MYSQL_BUFFER_POOL=1G

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=__REPLACE_REDIS_PASSWORD__
REDIS_MAXMEMORY=2gb

# ── ClickHouse ───────────────────────────────────────────────
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=__REPLACE_CLICKHOUSE_PASSWORD__

# ── JWT（长度必须 >= 32，建议 64 位随机） ─────────────────────
ADMIN_JWT_SECRET=__REPLACE_JWT_SECRET_64_CHARS__
ADMIN_JWT_TTL_SECONDS=7200
ADMIN_JWT_REFRESH_TTL_SECONDS=604800


# ============================================================
# 三、服务连接串
# ------------------------------------------------------------
# 主机名用 Docker 服务名（mysql / redis / clickhouse），
# 不要写 localhost —— 容器内 localhost 指向容器自身。
# 密码中的特殊字符需 URL 编码。
# ============================================================

ADMIN_DATABASE_URL=mysql+asyncmy://fangyu:__REPLACE_MYSQL_PASSWORD_URLENCODED__@mysql:3306/fangyu_v2

GATEWAY_REDIS_URL=redis://:__REPLACE_REDIS_PASSWORD_URLENCODED__@redis:6379/0
ADMIN_REDIS_URL=redis://:__REPLACE_REDIS_PASSWORD_URLENCODED__@redis:6379/1
WORKER_REDIS_URL=redis://:__REPLACE_REDIS_PASSWORD_URLENCODED__@redis:6379/0

# Redis Stream：gateway 写入、worker 消费，两侧必须完全一致
STREAM_NAME=fangyu:events:decision
WORKER_CONSUMER_GROUP=fangyu-worker
WORKER_CONSUMER_NAME=worker-1


# ============================================================
# 四、CORS（必须是 JSON 数组）
# ------------------------------------------------------------
# 生产环境禁止使用 ["*"]：admin 侧 allow_credentials=True，
# 与通配源同时启用会被浏览器拒绝，且等于放弃跨站防护。
# ============================================================

# 管理后台域名。前端与 admin-api 同源（经容器内 Nginx 反代），
# 正常只需填后台自身域名。
ADMIN_CORS_ORIGINS=["https://admin.example.com"]

# 接入 SDK 的业务站点域名，逐个列出
GATEWAY_CORS_ORIGINS=["https://www.example.com","https://shop.example.com"]


# ============================================================
# 五、容量与资源限制
# ============================================================

GATEWAY_WORKERS=4
ADMIN_WORKERS=2
GATEWAY_CPU_LIMIT=2
GATEWAY_MEM_LIMIT=1g
ADMIN_CPU_LIMIT=1
ADMIN_MEM_LIMIT=1g
WORKER_CPU_LIMIT=1
WORKER_MEM_LIMIT=1g

ADMIN_DATABASE_POOL_SIZE=10
ADMIN_DATABASE_MAX_OVERFLOW=20
WORKER_BATCH_SIZE=500


# ============================================================
# 六、风控策略
# ============================================================

GATEWAY_CHALLENGE_THRESHOLD=30.0
GATEWAY_BLOCK_THRESHOLD=75.0
GATEWAY_BLOCK_TOR=true
GATEWAY_APP_KEY_REQUIRED=true

# 请求签名：开启前需完成客户端 SDK 灰度，存量适配器未带 sign 字段
GATEWAY_SIGNATURE_REQUIRED=false

WORKER_REPUTATION_ENABLED=true

# 登录接口限流（次/分钟）
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10


# ============================================================
# 七、外部服务（留空则跳过对应功能）
# ============================================================

ABUSEIPDB_API_KEY=
MAXMIND_LICENSE_KEY=

# 链路追踪：不部署 Jaeger/OTel Collector 时留空
OTLP_ENDPOINT=
TRACE_SAMPLE_RATE=0.1

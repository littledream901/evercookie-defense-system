# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀
# 保持为 /，由容器内 Nginx 的 location /api/ 反代到 admin-api 并剥离 /api 前缀。
# 前端实际请求 /api/v2/xxx → admin-api 收到 /v2/xxx。
# 若改为完整域名（跨域直连 admin-api），必须同步配置 ADMIN_CORS_ORIGINS。
VITE_API_URL = /

# 网关地址（SDK 上报入口，部署时替换为实际域名）
VITE_GATEWAY_URL = https://defense.example.com

# Delete console
VITE_DROP_CONSOLE = true
